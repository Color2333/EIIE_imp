{
    "agent_type": "ImprovedTransformerAgent",
    "input": {
        "coin_number": 11,
        "end_date": "2017/07/01",
        "feature_number": 3,
        "global_period": 1800,
        "is_permed": false,
        "market": "poloniex",
        "norm_method": "absolute",
        "online": false,
        "portion_reversed": false,
        "save_memory_mode": false,
        "start_date": "2015/07/01",
        "test_portion": 0.08,
        "volume_average_days": 30,
        "window_size": 31
    },
    "layers": [
        {
            "type": "EIIE_Output_WithW",
            "weight_decay": 1e-5
        }
    ],
    "transformer_config": {
        "d_model": 128,
        "nhead": 8,
        "num_encoder_layers": 4,
        "dim_feedforward": 512,
        "dropout": 0.1,
        "activation": "gelu",
        "use_asset_attention": true,
        "use_market_context": true,
        "pooling_method": "attention",
        "pos_encoding_type": "learnable",
        "context_dimensions": 4,
        "residual_connection": true
    },
    "random_seed": 0,
    "trading": {
        "buffer_biased": 5e-05,
        "learning_rate": 0.0002,
        "rolling_training_steps": 85,
        "trading_consumption": 0.0025
    },
    "training": {
        "batch_size": 64,
        "buffer_biased": 5e-05,
        "decay_rate": 0.95,
        "decay_steps": 50000,
        "fast_train": true,
        "learning_rate": 0.0001,
        "loss_function": "loss_function6",
        "snap_shot": true,
        "steps": 80000,
        "training_method": "Adam",
        "weight_decay": 1e-5
    }
}